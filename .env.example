# ─── Database ─────────────────────────────────────────────────────────────────
# Async PostgreSQL URL (shared web-folders instance)
DATABASE_URL=postgresql+asyncpg://user:password@postgres_host:5432/auth_db

# ─── Admin seed account ───────────────────────────────────────────────────────
ADMIN_USERNAME=admin
ADMIN_PASSWORD=change_me_admin

# ─── Seeded regular users ─────────────────────────────────────────────────────
USER1_USERNAME=user1
USER1_PASSWORD=change_me_user1

USER2_USERNAME=user2
USER2_PASSWORD=change_me_user2

# ─── Token settings ───────────────────────────────────────────────────────────
TOKEN_TTL_HOURS=24

# ─── Application secret (used for internal signing / CSRF state) ──────────────
# Generate with: python3 -c "import secrets; print(secrets.token_hex(32))"
SECRET_KEY=replace_with_64_hex_chars

# ─── Google OAuth2 ────────────────────────────────────────────────────────────
GOOGLE_CLIENT_ID=your-google-client-id.apps.googleusercontent.com
GOOGLE_CLIENT_SECRET=your-google-client-secret
GOOGLE_REDIRECT_URI=https://auth.mainpage.com/api/auth/callback/google

# ─── GitHub OAuth ─────────────────────────────────────────────────────────────
GITHUB_CLIENT_ID=your-github-client-id
GITHUB_CLIENT_SECRET=your-github-client-secret
GITHUB_REDIRECT_URI=https://auth.mainpage.com/api/auth/callback/github

# ─── Application URLs ─────────────────────────────────────────────────────────
AUTH_APP_URL=https://auth.mainpage.com

# ─── Cookie domain (shared across all protected apps) ─────────────────────────
COOKIE_DOMAIN=.mainpage.com

# ─── Runtime environment ──────────────────────────────────────────────────────
# Values: development | production
ENVIRONMENT=production

# ─── CORS allowed origins ─────────────────────────────────────────────────────
# Comma-separated list of origins permitted to call the API
ALLOWED_ORIGINS=https://auth.mainpage.com,https://budget-site.mainpage.com,https://family-admin-routine.mainpage.com,https://family-archive.mainpage.com,https://family-kitchen-recipes.mainpage.com,https://new-site.mainpage.com,https://portuguese-expenses.mainpage.com,https://reminders-app.mainpage.com,https://servinga-dashboard.mainpage.com
